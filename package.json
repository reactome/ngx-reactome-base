{
  "name": "ngx-reactome-style",
  "version": "0.1.0",
  "description": "Shared Reactome Angular Material theme (Sass only).",
  "peerDependencies": {
    "@angular/material": ">=19.0.0"
  },
  "sideEffects": false,
  "module": "fesm2022/ngx-reactome-style.mjs",
  "typings": "types/ngx-reactome-style.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/ngx-reactome-style.d.ts",
      "default": "./fesm2022/ngx-reactome-style.mjs"
    }
  },
  "type": "module",
  "dependencies": {
    "tslib": "^2.3.0"
  }
}