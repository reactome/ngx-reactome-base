{
  "name": "ngx-reactome-base",
  "version": "0.0.19",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:libs && ng build ngx-reactome-base",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-reactome-cytoscape-style --watch=false && ng test ngx-reactome-diagram --watch=false && ng test ngx-reactome-base --watch=false",
    "build-style": "ng build ngx-reactome-style",
    "build-diagram": "ng build ngx-reactome-diagram && cd dist/ngx-reactome-diagram && npm pack",
    "build-cytoscape-style": "ng build ngx-reactome-cytoscape-style && cd dist/ngx-reactome-cytoscape-style && npm pack",
    "build:libs": "ng build ngx-reactome-cytoscape-style && ng build ngx-reactome-style && ng build ngx-reactome-diagram"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@ngneat/until-destroy": "^10.0.0",
    "chroma-js": "^3.2.0",
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-layers": "^3.1.0",
    "lodash": "^4.18.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vectorious": "^6.1.12",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.25",
    "@types/chroma-js": "^3.1.2",
    "@types/cytoscape-fcose": "^2.2.4",
    "@types/lodash": "^4.14.202",
    "angular-cli-ghpages": "^1.0.6",
    "jsdom": "^30.1.1",
    "ng-packagr": "^21.2.7",
    "npm-run-all": "^4.1.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
