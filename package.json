{
  "name": "ngx-reactome-cytoscape-style",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./assets": {
      "sass": "./assets/index.scss",
      "style": "./assets/index.scss",
      "default": "./assets/index.scss"
